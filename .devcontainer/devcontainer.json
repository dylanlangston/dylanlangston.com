{
	"name": "dylanlangston.com",
	"build": { 
		"dockerfile": "devcontainer.Dockerfile",
		"target": "base",
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {}
	},
	"containerUser": "vscode",
	// Init top-level submodules first; the nested gist inside `resume` may
	// require external auth and is optional for development, so it is allowed
	// to fail. LFS objects are pulled where available.
	"postCreateCommand": "git submodule update --init emsdk raygui raylib && (git submodule update --init resume || true) && git submodule foreach --quiet 'git lfs pull || true' && make setup",
	"forwardPorts": [5173],
	"portsAttributes": {
		"5173": {
			"label": "Dev Server",
			"onAutoForward": "notify"
		}
	},
	"runArgs": ["--volume=/var/lib/docker", "--privileged"],
	"customizations": {
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode",
				"ziglang.vscode-zig",
				"vadimcn.vscode-lldb",
				"ms-vscode.makefile-tools",
				"oven.bun-vscode",
				"ms-azuretools.vscode-docker",
				"ms-vscode-remote.remote-containers",
				"gitpod.gitpod-desktop",
				"github.vscode-github-actions",
				"GitHub.codespaces",
				"bierner.markdown-preview-github-styles",
				"bierner.markdown-mermaid",
				"dtoplak.vscode-glsllint",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"redhat.vscode-yaml",
				"amazonwebservices.aws-toolkit-vscode",
				"ms-python.python",
				"bradlc.vscode-tailwindcss"
			],
			"settings": {
				"zig.path": "",
				"zig.zls.path": "",
				"zig.initialSetupDone": true,
				"svelte.enable-ts-plugin": true,
				"glsllint.additionalStageAssociations": {
					".fs": "frag",
					".vs": "vert"
				},
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"[zig]": {
					"editor.defaultFormatter": "ziglang.vscode-zig"
				},
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer"
				}
			}
		}
	}
}
